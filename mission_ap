#include <ros/ros.h>
#include <nav_msgs/Odometry.h>
#include <geometry_msgs/PoseStamped.h>
#include <mavros_msgs/State.h>
#include <mavros_msgs/SetMode.h>
#include <mavros_msgs/CommandBool.h>
#include <mavros_msgs/CommandTOL.h>
#include <cmath>
#include <fstream>
#include <vector>
#include <string>
#include <cstdlib>
#include <iomanip>

struct Point {
    double x, y, z;
};

Point current_pose{0.0, 0.0, 0.0};
bool odom_received = false;
mavros_msgs::State current_state;

void odomCallback(const nav_msgs::Odometry::ConstPtr& msg) {
    current_pose.x = msg->pose.pose.position.x;
    current_pose.y = msg->pose.pose.position.y;
    current_pose.z = msg->pose.pose.position.z;
    odom_received = true;
}

void stateCallback(const mavros_msgs::State::ConstPtr& msg) {
    current_state = *msg;
}

double getDistance3D(const Point& p1, const Point& p2) {
    double dx = p1.x - p2.x;
    double dy = p1.y - p2.y;
    double dz = p1.z - p2.z;
    return std::sqrt(dx * dx + dy * dy + dz * dz);
}

bool loadPointParam(ros::NodeHandle& nh, const std::string& param_name, Point& pt) {
    std::vector<double> p;
    if (!nh.getParam(param_name, p) && !ros::param::get(param_name, p)) {
        ROS_ERROR_STREAM("Failed to load parameter [" << param_name << "] from parameter server/YAML!");
        return false;
    }
    if (p.size() < 3) {
        ROS_ERROR_STREAM("Parameter [" << param_name << "] must contain at least 3 values [x, y, z]!");
        return false;
    }
    pt.x = p[0];
    pt.y = p[1];
    pt.z = p[2];
    return true;
}

template <typename Cond>
bool waitFor(Cond cond, double timeout_sec) {
    ros::Rate r(20);
    ros::Time t0 = ros::Time::now();
    while (ros::ok()) {
        ros::spinOnce();
        if (cond()) return true;
        if (timeout_sec > 0 && (ros::Time::now() - t0).toSec() > timeout_sec) return false;
        r.sleep();
    }
    return false;
}

int main(int argc, char** argv) {
    ros::init(argc, argv, "mission_node");
    ros::NodeHandle nh;

    Point ptA, ptB, ptC, ptD;
    bool success = true;
    success &= loadPointParam(nh, "point_A", ptA);
    success &= loadPointParam(nh, "point_B", ptB);
    success &= loadPointParam(nh, "point_C", ptC);
    success &= loadPointParam(nh, "point_D", ptD);
    if (!success) {
        ROS_FATAL("Mission node terminated due to missing or invalid point parameters.");
        return 1;
    }

    const double h = ptA.z;

    ROS_INFO("Waypoints loaded from YAML:");
    ROS_INFO("Point A: [%.2f, %.2f, %.2f]", ptA.x, ptA.y, ptA.z);
    ROS_INFO("Point B: [%.2f, %.2f, %.2f]", ptB.x, ptB.y, ptB.z);
    ROS_INFO("Point C: [%.2f, %.2f, %.2f]", ptC.x, ptC.y, ptC.z);
    ROS_INFO("Point D: [%.2f, %.2f, %.2f]", ptD.x, ptD.y, ptD.z);
    ROS_INFO("Takeoff altitude: %.2f m", h);

    std::vector<Point> waypoints = {ptA, ptB, ptC, ptD, ptA};
    std::vector<std::string> target_names = {"A", "B", "C", "D", "A"};
    std::vector<std::string> segment_names = {"->A", "A->B", "B->C", "C->D", "D->A"};

    ros::Subscriber sub_state = nh.subscribe("/mavros/state", 10, stateCallback);
    ros::Subscriber sub_odom = nh.subscribe("/mavros/local_position/odom", 10, odomCallback);
    ros::Publisher pub_goal = nh.advertise<geometry_msgs::PoseStamped>("/mavros/setpoint_position/local", 10);
    ros::ServiceClient set_mode_cli = nh.serviceClient<mavros_msgs::SetMode>("/mavros/set_mode");
    ros::ServiceClient arming_cli = nh.serviceClient<mavros_msgs::CommandBool>("/mavros/cmd/arming");
    ros::ServiceClient takeoff_cli = nh.serviceClient<mavros_msgs::CommandTOL>("/mavros/cmd/takeoff");

    ROS_INFO("Waiting for FCU connection...");
    if (!waitFor([] { return current_state.connected; }, 0)) return 1;
    ROS_INFO("FCU connected.");

    ROS_INFO("Waiting for initial odometry...");
    if (!waitFor([] { return odom_received; }, 0)) return 1;
    ROS_INFO("Odometry received.");

    while (ros::ok() && current_state.mode != "GUIDED") {
        mavros_msgs::SetMode sm;
        sm.request.custom_mode = "GUIDED";
        if (set_mode_cli.call(sm) && sm.response.mode_sent)
            ROS_INFO("set_mode GUIDED sent");
        else
            ROS_WARN("set_mode GUIDED failed");
        waitFor([] { return current_state.mode == "GUIDED"; }, 1.0);
    }
    ROS_INFO("Mode is GUIDED.");

    bool airborne = false;
    while (ros::ok() && !airborne) {
        while (ros::ok() && !current_state.armed) {
            mavros_msgs::CommandBool arm;
            arm.request.value = true;
            if (arming_cli.call(arm) && arm.response.success)
                ROS_INFO("arm command accepted");
            else
                ROS_WARN("arm rejected (result=%d), retrying...", arm.response.result);
            if (waitFor([] { return current_state.armed; }, 1.5)) break;
        }
        if (!ros::ok()) return 1;
        ROS_INFO("Armed.");

        mavros_msgs::CommandTOL tk;
        tk.request.altitude = h;
        tk.request.min_pitch = 0;
        tk.request.yaw = 0;
        tk.request.latitude = 0;
        tk.request.longitude = 0;
        if (takeoff_cli.call(tk) && tk.response.success) {
            ROS_INFO("takeoff to %.2f m accepted", h);
        } else {
            ROS_WARN("takeoff rejected (result=%d), retrying from arm", tk.response.result);
            continue;
        }

        ros::Time t0 = ros::Time::now();
        waitFor([&] {
            return current_pose.z >= 0.95 * h || !current_state.armed
                   || (ros::Time::now() - t0).toSec() > 40.0;
        }, 0);
        if (current_pose.z >= 0.95 * h) {
            airborne = true;
            ROS_INFO("Reached altitude %.2f m", current_pose.z);
        } else {
            ROS_WARN("Takeoff failed (armed=%d, z=%.2f). Back to arming.", current_state.armed, current_pose.z);
        }
    }
    if (!airborne) return 1;

    std::string home_dir = std::getenv("HOME") ? std::getenv("HOME") : "/home/user";
    std::string csv_path = home_dir + "/mission_log.csv";
    std::ofstream csv_file(csv_path.c_str());
    if (csv_file.is_open()) {
        csv_file << "time_sec,x,y,z,target_id,dist_to_target\n";
    } else {
        ROS_WARN("Could not open CSV file for logging at: %s", csv_path.c_str());
    }

    ros::Time start_mission_time = ros::Time::now();
    Point prev_pose = current_pose;
    double total_distance = 0.0;
    std::vector<double> segment_times;

    for (size_t i = 0; i < waypoints.size(); ++i) {
        Point target = waypoints[i];
        ros::Time segment_start_time = ros::Time::now();
        ROS_INFO("--- Segment %s (target %s) ---", segment_names[i].c_str(), target_names[i].c_str());

        geometry_msgs::PoseStamped goal;
        goal.header.frame_id = "map";
        goal.pose.position.x = target.x;
        goal.pose.position.y = target.y;
        goal.pose.position.z = target.z;
        goal.pose.orientation.w = 1.0;

        bool inside_radius = false;
        ros::Time close_start_time;
        ros::Rate rate(10);

        while (ros::ok()) {
            ros::spinOnce();
            ros::Time now = ros::Time::now();

            goal.header.stamp = now;
            pub_goal.publish(goal);

            total_distance += getDistance3D(current_pose, prev_pose);
            prev_pose = current_pose;

            double dist_to_target = getDistance3D(current_pose, target);
            double time_from_start = (now - start_mission_time).toSec();

            if (csv_file.is_open()) {
                csv_file << std::fixed << std::setprecision(3)
                         << time_from_start << "," << current_pose.x << ","
                         << current_pose.y << "," << current_pose.z << ","
                         << (i + 1) << "," << dist_to_target << "\n";
            }

            if (dist_to_target < 0.5) {
                if (!inside_radius) {
                    inside_radius = true;
                    close_start_time = now;
                } else if ((now - close_start_time).toSec() >= 1.0) {
                    ROS_INFO("Target %s reached!", target_names[i].c_str());
                    break;
                }
            } else {
                inside_radius = false;
            }

            if (!current_state.armed) {
                ROS_ERROR("Vehicle disarmed during mission!");
                break;
            }
            rate.sleep();
        }
        segment_times.push_back((ros::Time::now() - segment_start_time).toSec());
    }

    if (csv_file.is_open()) {
        csv_file.close();
        ROS_INFO("Flight log saved to: %s", csv_path.c_str());
    }
    double total_mission_time = (ros::Time::now() - start_mission_time).toSec();

    mavros_msgs::SetMode land;
    land.request.custom_mode = "LAND";
    while (ros::ok() && current_state.mode != "LAND") {
        if (set_mode_cli.call(land) && land.response.mode_sent) ROS_INFO("set_mode LAND sent");
        waitFor([] { return current_state.mode == "LAND"; }, 1.0);
    }
    ROS_INFO("Landing... waiting for auto-disarm");
    waitFor([] { return !current_state.armed; }, 0);
    ROS_INFO("Landed and disarmed.");

    ROS_INFO("================ MISSION RESULTS ================");
    ROS_INFO("Total flight time: %.2f sec", total_mission_time);
    ROS_INFO("Total distance traveled: %.2f m", total_distance);
    ROS_INFO("Segment times:");
    for (size_t i = 0; i < segment_times.size(); ++i)
        ROS_INFO("  Segment %s: %.2f sec", segment_names[i].c_str(), segment_times[i]);
    ROS_INFO("=================================================");
    return 0;
}
